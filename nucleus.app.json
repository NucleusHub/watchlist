{
  "id": "watchlist",
  "name": "Watchlist",
  "description": "Movies & shows",
  "route": "/watchlist",
  "icon": "M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 01-1.125-1.125M3.375 19.5h1.5C5.496 19.5 6 18.996 6 18.375m-3.75.125-.375-12a1.125 1.125 0 011.125-1.125h15.75A1.125 1.125 0 0120.625 6.5l-.375 12M6 18.375V7.875C6 7.254 6.504 6.75 7.125 6.75h9.75C17.496 6.75 18 7.254 18 7.875v10.5m0 0c0 .621-.504 1.125-1.125 1.125H7.125",
  "category": "media",
  "hub": {
    "showInSidebar": true,
    "showOnDashboard": true
  },
  "nginx": {
    "routes": [
      {
        "path": "/watchlist",
        "upstream": "watchlist-client:5173",
        "websocket": true
      },
      {
        "path": "/api",
        "upstream": "watchlist-server:3000"
      },
      {
        "path": "/uploads",
        "upstream": "watchlist-server:3000"
      }
    ]
  },
  "server": {
    "service": "watchlist-server",
    "port": 3000,
    "env": {
      "MONGODB_URI": "mongodb://mongo:27017/nucleus",
      "JWT_SECRET": "${JWT_SECRET:-nucleus-jwt-secret}"
    },
    "depends": [
      "mongo"
    ],
    "namedVolumes": [
      "uploads_data:/app/uploads"
    ],
    "healthEndpoint": "/api/health"
  }
}
