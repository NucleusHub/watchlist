{
  "id": "watchlist",
  "name": "Watchlist",
  "description": "Movies & shows",
  "version": "0.3.1",
  "manifestVersion": 1,
  "compatibility": {
    "nucleus": ">=0.1.0 <1.0.0"
  },
  "route": "/watchlist",
  "icon": "icon.svg",
  "category": "media",
  "hub": {
    "showInSidebar": true,
    "showOnDashboard": true
  },
  "nginx": {
    "routes": [
      {
        "path": "/watchlist",
        "upstream": "watchlist-client:5173",
        "websocket": true
      },
      {
        "path": "/api",
        "upstream": "watchlist-server:3000"
      },
      {
        "path": "/uploads",
        "upstream": "watchlist-server:3000"
      }
    ]
  },
  "server": {
    "service": "watchlist-server",
    "port": 3000,
    "env": {
      "MONGODB_URI": "mongodb://mongo:27017/nucleus",
      "JWT_SECRET": "${JWT_SECRET:-nucleus-jwt-secret}"
    },
    "depends": [
      "mongo"
    ],
    "namedVolumes": [
      "uploads_data:/app/uploads"
    ],
    "bindMounts": [
      "../core:/app/core:ro"
    ],
    "healthEndpoint": "/api/health"
  }
}
